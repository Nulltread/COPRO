# Port d'écoute de l'application
PORT=3000

# Chemins de stockage (laisser par défaut dans Docker)
# DB_PATH=./data/copro.db
# UPLOAD_DIR=./uploads

# Envoi de mails via le serveur mail local (SMTP, sans authentification)
# SMTP_HOST=127.0.0.1
# SMTP_PORT=25
# MAIL_FROM=noreply@copro-pinede-gardanne.fr
# BASE_URL=https://copro.mondomaine.fr   # URL publique, pour les liens dans les emails
# MAIL_ENABLED=true   # mettre false pour désactiver l'envoi de mails

# Synchro automatique de la liste de diffusion conseil-syndical@ (API Mailcow)
# MAIL_DOMAIN=copro-pinede-gardanne.fr
# MAILCOW_API_URL=https://mail.copro-pinede-gardanne.fr:8443
# MAILCOW_API_KEY=
