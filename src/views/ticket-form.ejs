<%- include('partials/header', { titre: 'Nouveau ticket' }) %>
<h1>Nouveau ticket</h1>
<% if (erreur) { %><p class="erreur"><%= erreur %></p><% } %>
<% if (mesUnites.length === 0) { %>
  <p class="aide">Votre rattachement à une villa ou un garage doit d'abord être accepté (par un résident de l'unité ou le conseil syndical) avant de pouvoir déclarer un ticket. <a href="/rattachements">Voir mes rattachements</a></p>
<% } %>
<form method="post" action="/tickets" class="formulaire" enctype="multipart/form-data">
  <label>Titre court
    <input type="text" name="titre" required maxlength="120" placeholder="Ex. : fuite sous l'évier">
  </label>
  <label>Description
    <textarea name="description" rows="4" placeholder="Décrivez simplement le problème"></textarea>
  </label>
  <fieldset>
    <legend>Villa(s) / garage(s) concerné(s) — au moins une de vos unités</legend>
    <label>Unités concernées
      <select name="unite_ids" multiple required size="10">
        <% for (const u of unites) { %>
          <option value="<%= u.id %>" <%= mesUnites.includes(u.id) ? 'selected' : '' %>><%= u.label %><% if (mesUnites.includes(u.id)) { %> (votre unité)<% } %></option>
        <% } %>
      </select>
    </label>
    <p class="aide">Maintenez Ctrl (ou Cmd sur Mac) pour sélectionner plusieurs unités. Vos unités sont présélectionnées.</p>
    <% if (user.conseil_syndical === 1 || user.role === 'admin') { %>
      <p class="aide">En tant que membre du conseil syndical, vous pouvez aussi déclarer un ticket sur les parties communes.</p>
    <% } %>
  </fieldset>
  <label class="toggle-urgent">
    <input type="checkbox" name="urgent" value="1" class="toggle-case">
    <span class="toggle-piste" aria-hidden="true"></span>
    <span>🚨 C'est urgent (fuite, danger…)</span>
  </label>
  <label>Photos (compressées automatiquement avant l'envoi)
    <input type="file" name="fichiers" accept="image/jpeg,image/png,image/webp,application/pdf" multiple id="champ-photos">
  </label>
  <div id="apercu-photos" class="apercu"></div>
  <button type="submit" class="bouton">Déclarer le ticket</button>
</form>
<%- include('partials/footer') %>
