<%- include('partials/header', { titre: 'Comptes' }) %>
<h1>Comptes</h1>
<% if (message) { %><p class="info"><%= message %></p><% } %>
<% if (erreur) { %><p class="erreur"><%= erreur %></p><% } %>
<p class="aide">Le statut de membre du conseil syndical (CS) se gère collégialement : l'administrateur et tout membre du CS peuvent ajouter ou retirer ce statut. Chaque action demande une confirmation. Les comptes sont créés ici par le CS/admin (les propriétaires ne s'auto-inscrivent pas) ; sans email, un compte reste inaccessible jusqu'à ce qu'une adresse soit renseignée (un mail de réinitialisation du mot de passe est alors envoyé automatiquement).</p>
<section class="bloc">
  <h2>Créer un compte</h2>
  <form method="post" action="/admin/comptes/creer" class="formulaire" data-confirm="Créer ce compte ?" data-confirm-titre="Créer un compte">
    <label>Nom
      <input type="text" name="nom" required autocomplete="off">
    </label>
    <label>Prénom
      <input type="text" name="prenom" required autocomplete="off">
    </label>
    <label>Téléphone (facultatif)
      <input type="tel" name="telephone" autocomplete="off">
    </label>
    <label>Email (facultatif — un mail de réinitialisation du mot de passe est envoyé si renseigné)
      <input type="email" name="email" autocomplete="off">
    </label>
    <label>Lot du propriétaire (facultatif)
      <select name="lot_id">
        <option value="">— Aucun lot —</option>
        <% for (const l of lotsLibres) { %>
          <option value="<%= l.id %>">Lot <%= l.numero %> — <%= l.designation %></option>
        <% } %>
      </select>
    </label>
    <button class="bouton" type="submit">Créer le compte</button>
  </form>
</section>
<input type="search" id="recherche-comptes" class="recherche" placeholder="Rechercher un compte (nom, prénom, n° de villa/garage, lot, statut)…" autocomplete="off">
<ul class="liste-simple" id="liste-comptes">
  <% for (const u of users) { %>
    <li data-recherche="<%= (u.prenom + ' ' + u.nom + ' ' + (u.email || '') + ' ' + (u.unites || '') + ' ' + (u.lots || '') + ' ' + u.statut).toLowerCase() %>">
      <strong><%= u.prenom %> <%= u.nom %></strong> — <%= u.email || 'sans email' %> — <%= u.unites || 'aucune unité' %><% if (u.lots) { %> — <%= u.lots %><% } %>
      <% if (u.conseil_syndical === 1) { %><span class="tag-cs">CS</span><% } %>
      <% if (u.role === 'admin') { %><span class="auteur">admin</span><% } %>
      <% if (u.statut === 'desactive') { %><span class="auteur">compte désactivé</span><% } %>
      <% if (u.statut === 'supprime') { %><span class="auteur">compte supprimé</span><% } %>
      <% if (u.role !== 'admin' && (user.conseil_syndical === 1 || user.role === 'admin')) { %>
        <% if (u.conseil_syndical === 1) { %>
          <form method="post" action="/admin/comptes/<%= u.id %>/conseil" class="formulaire-ligne" data-confirm="Confirmer le retrait du conseil syndical de « <%= u.prenom %> <%= u.nom %> » ?" data-confirm-titre="Retirer du conseil syndical">
            <button class="bouton-secondaire" type="submit" name="action" value="retirer">Retirer du CS</button>
          </form>
        <% } else { %>
          <form method="post" action="/admin/comptes/<%= u.id %>/conseil" class="formulaire-ligne" data-confirm="Confirmer l'ajout de « <%= u.prenom %> <%= u.nom %> » au conseil syndical ?" data-confirm-titre="Ajouter au conseil syndical">
            <button class="bouton-secondaire" type="submit" name="action" value="ajouter">Ajouter au CS</button>
          </form>
        <% } %>
      <% } %>
      <% if (u.role !== 'admin' && u.statut === 'actif' && (user.conseil_syndical === 1 || user.role === 'admin')) { %>
        <details>
          <summary>Modifier</summary>
          <form method="post" action="/admin/comptes/<%= u.id %>/modifier" class="formulaire formulaire-ligne" data-confirm="Enregistrer les modifications de « <%= u.prenom %> <%= u.nom %> » ?" data-confirm-titre="Modifier le compte">
            <label>Nom <input type="text" name="nom" value="<%= u.nom %>" required></label>
            <label>Prénom <input type="text" name="prenom" value="<%= u.prenom %>" required></label>
            <label>Téléphone <input type="tel" name="telephone" value="<%= u.telephone %>"></label>
            <label>Email (vide = sans email) <input type="email" name="email" value="<%= u.email || '' %>"></label>
            <button class="bouton-secondaire" type="submit">Enregistrer</button>
          </form>
          <% if (u.email) { %>
            <form method="post" action="/admin/comptes/<%= u.id %>/renvoyer-reset" class="formulaire-ligne" data-confirm="Renvoyer le mail de réinitialisation du mot de passe à « <%= u.email %> » ?" data-confirm-titre="Mail de réinitialisation">
              <button class="bouton-secondaire" type="submit">Renvoyer le mail de réinitialisation</button>
            </form>
          <% } %>
        </details>
      <% } %>
    </li>
  <% } %>
</ul>
<p class="aide" id="recherche-aucun" hidden>Aucun compte ne correspond à cette recherche.</p>
<%- include('partials/footer') %>
