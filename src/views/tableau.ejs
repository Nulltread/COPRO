<%- include('partials/header', { titre: 'Tableau de bord' }) %>
<h1>Tableau de bord</h1>
<div class="cartes-stats">
  <div class="carte-stat"><span class="chiffre"><%= ouverts %></span><span class="legende">tickets ouverts</span></div>
  <div class="carte-stat"><span class="chiffre"><%= enConsultation %></span><span class="legende">en consultation</span></div>
  <div class="carte-stat urgent"><span class="chiffre"><%= urgents %></span><span class="legende">tickets urgents</span></div>
  <div class="carte-stat"><span class="chiffre"><%= coutRetenu.toFixed(2) %> €</span><span class="legende">coût retenu</span></div>
  <div class="carte-stat"><span class="chiffre"><%= totalFacture.toFixed(2) %> €</span><span class="legende">total facturé</span></div>
</div>
<h2>Activité récente</h2>
<ul class="liste-tickets">
  <% for (const t of recents) { %>
    <li class="carte-ticket <%= t.urgent ? 'urgent' : '' %>">
      <a href="/tickets/<%= t.id %>">
        <div class="ligne1"><strong><%= t.titre %></strong> <% if (t.urgent) { %><span class="tag-urgent">URGENT</span><% } %></div>
        <div class="ligne2">
          <span class="ligne2-gauche">
            <span class="mini-metro" aria-hidden="true">
              <% const idxEtape = etapes.indexOf(t.etape); etapes.forEach((e, i) => { %>
                <span class="mini-puce <%= t.etape === e ? 'etape-' + e : (idxEtape > i ? 'faite' : '') %>"></span>
                <% if (i < etapes.length - 1) { %><span class="mini-lien"></span><% } %>
              <% }) %>
            </span>
            <span class="tag-etape etape-<%= t.etape %>"><%= etiquettes[t.etape] %></span>
          </span>
          <span class="ligne2-unites"><%= t.unites || '' %></span>
        </div>
      </a>
    </li>
  <% } %>
</ul>
<%- include('partials/footer') %>
