<%- include('partials/header', { titre: ticket.titre }) %>
<div class="entete-page">
  <h1><%= ticket.titre %></h1>
  <% if (ticket.urgent) { %><span class="tag-urgent">URGENT</span><% } %>
</div>
<p class="aide"><%= unites.map(u => u.label).join(', ') %> · déclaré le <%= ticket.created_at %></p>

<ol class="metro">
  <% etapes.forEach((e, i) => { %>
    <li class="<%= ticket.etape === e ? 'actuelle' : (etapes.indexOf(ticket.etape) > i ? 'faite' : '') %>">
      <span class="puce"><%= etapes.indexOf(ticket.etape) > i ? '✓' : i + 1 %></span>
      <span class="nom"><%= etiquettes[e] %></span>
    </li>
  <% }) %>
</ol>

<% if (ticket.description) { %><p><%= ticket.description %></p><% } %>

<% if (peutEditer) { %>
<section class="bloc">
  <h2>Modifier le ticket</h2>
  <form method="post" action="/tickets/<%= ticket.id %>/editer" class="formulaire" enctype="multipart/form-data">
    <label>Description
      <textarea name="description" rows="4"><%= ticket.description %></textarea>
    </label>
    <div class="bloc-photos">
      <label class="zone-photos">
        <input type="file" name="fichiers" accept="image/jpeg,image/png,image/webp" multiple class="champ-fichiers champ-fichiers-caches">
        <span class="zone-photos-plus" aria-hidden="true">+</span>
        <span class="zone-photos-icone" aria-hidden="true">📷</span>
        <span class="zone-photos-texte">Ajouter des photos</span>
      </label>
      <div class="apercu"></div>
    </div>
    <button class="bouton-secondaire" type="submit">Enregistrer les modifications</button>
  </form>
</section>
<% } %>

<% if (peutEditer) { %>
<section class="bloc">
  <h2>Unités concernées</h2>
  <form method="post" action="/tickets/<%= ticket.id %>/unites" class="formulaire">
    <label>Unités concernées
      <select name="unite_ids" multiple required size="10">
        <% for (const u of unitesModifiables) { %>
          <option value="<%= u.id %>" <%= unitesIds.includes(u.id) ? 'selected' : '' %>><%= u.label %><% if (mesUnites.has(u.id)) { %> (votre unité)<% } %></option>
        <% } %>
      </select>
    </label>
    <p class="aide">Maintenez Ctrl (ou Cmd sur Mac) pour sélectionner plusieurs unités.</p>
    <button class="bouton-secondaire" type="submit">Modifier les unités</button>
  </form>
</section>
<% } %>

<section class="bloc">
  <h2>Coût du ticket</h2>
  <p>Devis retenus : <strong><%= coutRetenu.toFixed(2) %> €</strong> · Facturé : <strong><%= totalFacture.toFixed(2) %> €</strong> · Écart : <strong><%= (totalFacture - coutRetenu).toFixed(2) %> €</strong></p>
</section>

<% if (gestionnaire) { %>
<section class="bloc">
  <h2>Changer d'état</h2>
  <form method="post" action="/tickets/<%= ticket.id %>/transition" class="formulaire-ligne">
    <select name="etape">
      <% etapes.forEach(e => { if (e !== ticket.etape) { %>
        <option value="<%= e %>"><%= etiquettes[e] %></option>
      <% } }) %>
    </select>
    <input type="text" name="motif" placeholder="Motif (facultatif)">
    <button class="bouton" type="submit">Valider le passage</button>
  </form>
</section>
<% } else if (peutReouvrir) { %>
<section class="bloc">
  <h2>Réouvrir le ticket</h2>
  <form method="post" action="/tickets/<%= ticket.id %>/transition" class="formulaire-ligne">
    <input type="hidden" name="etape" value="<%= ticket.etape_avant_consultation %>">
    <button class="bouton" type="submit">Réouvrir (retour à « <%= etiquettes[ticket.etape_avant_consultation] %> »)</button>
  </form>
</section>
<% } %>

<% if (ticket.etape === 'travaux_acceptes' && estConcerne) { %>
<section class="bloc">
  <h2>Résolution (travaux acceptés)</h2>
  <p class="aide">La résolution doit être acceptée par tous les résidents concernés<% if (!gestionnaire) { %> (un membre du conseil syndical peut accepter seul)<% } %> pour archiver le ticket.</p>
  <ul class="liste-simple">
    <% for (const r of residents) { %>
      <li><%= r.nom %> — <% if (resolutions.some(x => x.user_id === r.id)) { %>✅ accepté<% } else { %>⏳ en attente<% } %></li>
    <% } %>
  </ul>
  <form method="post" action="/tickets/<%= ticket.id %>/resolution">
    <button class="bouton" type="submit">J'accepte la résolution</button>
  </form>
</section>
<% } %>

<section class="bloc">
  <h2>Documents</h2>
  <div class="docs">
    <% const parCat = {}; fichiers.forEach(f => { (parCat[f.categorie] = parCat[f.categorie] || []).push(f); }); %>
    <% const nomsCat = { photo: 'Photos', devis: 'Devis', avenant: 'Avenants', facture: 'Factures', decision: 'Décisions', compte_rendu: 'Comptes-rendus (documents)' }; %>
    <% for (const cat of categoriesFichier) { if (!parCat[cat]) continue; %>
      <h3><%= nomsCat[cat] %></h3>
      <ul class="liste-docs">
        <% for (const f of parCat[cat]) { %>
          <li>
            <a href="/fichiers/<%= f.id %>" target="_blank" rel="noopener">📄 <%= f.nom_original %></a>
            <% if (f.montant != null) { %><span class="montant"><%= f.montant.toFixed(2) %> €</span><% } %>
            <% if (f.entreprise) { %><span class="auteur"><%= f.entreprise %></span><% } %>
            <% if (f.delai) { %><span class="auteur">délai : <%= f.delai %></span><% } %>
            <% if (f.retenu) { %><span class="tag-retenu">RETENU</span><% } %>
            <span class="auteur">par <%= f.auteur_nom || 'Compte supprimé' %></span>
            <% if (f.categorie === 'photo' && (f.auteur_id === user.id || gestionnaire)) { %>
              <form method="post" action="/fichiers/<%= f.id %>/supprimer" class="formulaire-ligne" onsubmit="return confirm('Supprimer cette photo ?');">
                <button class="bouton-secondaire" type="submit">Supprimer</button>
              </form>
            <% } %>
          </li>
        <% } %>
      </ul>
      <% if (gestionnaire && (cat === 'devis' || cat === 'avenant')) { %>
        <form method="post" action="/tickets/<%= ticket.id %>/decision" class="formulaire-ligne">
          <% for (const f of parCat[cat]) { if (!f.retenu) { %>
            <label class="case"><input type="radio" name="fichier_id" value="<%= f.id %>" required> <%= f.nom_original %> (<%= f.montant != null ? f.montant + ' €' : '?' %>, <%= f.entreprise || '?' %>)</label>
          <% } } %>
          <input type="text" name="justification" placeholder="Justification de la décision">
          <button class="bouton" type="submit">Enregistrer la décision</button>
        </form>
      <% } %>
    <% } %>
  </div>
  <form method="post" action="/tickets/<%= ticket.id %>/fichiers" enctype="multipart/form-data" class="formulaire">
    <label>Catégorie
      <select name="categorie">
        <% if (gestionnaire) { %>
          <% for (const c of categoriesFichier) { %><option value="<%= c %>"><%= c %></option><% } %>
        <% } else { %>
          <option value="photo">photo</option>
          <option value="compte_rendu">compte_rendu</option>
        <% } %>
      </select>
    </label>
    <% if (gestionnaire) { %>
      <label>Montant (€) — pour devis, avenants, factures
        <input type="number" step="0.01" min="0" name="montant">
      </label>
      <label>Entreprise
        <input type="text" name="entreprise">
      </label>
      <label>Délai
        <input type="text" name="delai" placeholder="Ex. : 2 semaines">
      </label>
    <% } %>
    <div class="bloc-photos">
      <label class="zone-photos">
        <input type="file" name="fichiers" accept="image/jpeg,image/png,image/webp,application/pdf" multiple required class="champ-fichiers champ-fichiers-caches">
        <span class="zone-photos-plus" aria-hidden="true">+</span>
        <span class="zone-photos-icone" aria-hidden="true">📷</span>
        <span class="zone-photos-texte">Ajouter des fichiers<br><small>images compressées automatiquement, PDF acceptés</small></span>
      </label>
      <div class="apercu"></div>
    </div>
    <button class="bouton" type="submit">Ajouter</button>
  </form>
</section>

<section class="bloc" id="cr">
  <h2>Comptes-rendus d'intervention</h2>
  <% const crParUnite = {}; comptesRendus.forEach(cr => { crParUnite[cr.unit_id === null ? 'cs' : cr.unit_id] = cr; }); %>
  <% for (const u of unites) { const cr = crParUnite[u.id]; %>
    <h3><%= u.label %></h3>
    <% if (cr) { %><p><%= cr.contenu %></p><p class="aide">rédigé par <%= cr.auteur_nom || 'Compte supprimé' %> le <%= cr.updated_at %></p><% } %>
    <% if (estConcerne) { %>
      <form method="post" action="/tickets/<%= ticket.id %>/cr" class="formulaire-ligne">
        <input type="hidden" name="unit_id" value="<%= u.id %>">
        <input type="text" name="contenu" placeholder="Compte-rendu pour <%= u.label %>…" value="<%= cr ? cr.contenu : '' %>" required>
        <button class="bouton-secondaire" type="submit">Enregistrer</button>
      </form>
    <% } %>
  <% } %>
  <h3>Conseil syndical</h3>
  <% const crCS = crParUnite['cs']; %>
  <% if (crCS) { %><p><%= crCS.contenu %></p><p class="aide">rédigé par <%= crCS.auteur_nom || 'Compte supprimé' %> le <%= crCS.updated_at %></p><% } %>
  <% if (estConcerne) { %>
    <form method="post" action="/tickets/<%= ticket.id %>/cr" class="formulaire-ligne">
      <input type="hidden" name="unit_id" value="cs">
      <input type="text" name="contenu" placeholder="Compte-rendu pour le conseil syndical…" value="<%= crCS ? crCS.contenu : '' %>" required>
      <button class="bouton-secondaire" type="submit">Enregistrer</button>
    </form>
  <% } %>
</section>

<section class="bloc" id="fil">
  <h2>Fil de suivi</h2>
  <ul class="fil">
    <% for (const e of evenements) { %>
      <li><span class="date"><%= e.created_at %></span> <strong><%= e.auteur_nom || 'Système' %></strong> — <%= e.contenu %></li>
    <% } %>
  </ul>
  <form method="post" action="/tickets/<%= ticket.id %>/commentaire" class="formulaire-ligne">
    <input type="text" name="contenu" placeholder="Écrire un commentaire…" required>
    <button class="bouton" type="submit">Envoyer</button>
  </form>
</section>

<% if (peutSupprimer) { %>
<section class="bloc">
  <form method="post" action="/tickets/<%= ticket.id %>/supprimer" onsubmit="return confirm('Supprimer définitivement ce ticket ?');">
    <button class="bouton-secondaire">🗑 Supprimer le ticket</button>
  </form>
</section>
<% } %>
<%- include('partials/footer') %>
