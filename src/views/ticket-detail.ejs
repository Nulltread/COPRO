<%- include('partials/header', { titre: ticket.titre }) %>
<div class="entete-page">
  <h1><%= ticket.titre %></h1>
  <div class="actions-titre">
    <% if (ticket.urgent) { %><span class="tag-urgent">URGENT</span><% } %>
    <% if (peutToggleUrgent) { %>
    <form method="post" action="/tickets/<%= ticket.id %>/urgent" class="formulaire-ligne" title="Modifiable uniquement à l’étape « Créé » par les acteurs du ticket">
      <label class="case"><input type="checkbox" name="urgent" value="1" <%= ticket.urgent ? 'checked' : '' %> onchange="this.form.submit()"> 🚨 Urgent</label>
    </form>
    <% } %>
    <form method="post" action="/tickets/<%= ticket.id %>/archiver" data-confirm="Archiver définitivement ce ticket ? Il ne sera plus jamais éditable (consultable uniquement)." data-confirm-titre="Archiver le ticket">
      <button class="bouton-secondaire" type="submit" <%= peutArchiver ? '' : 'disabled' %> title="<%= peutArchiver ? 'Archiver le ticket' : 'Déjà archivé' %>">Archiver</button>
    </form>
    <form method="post" action="/tickets/<%= ticket.id %>/supprimer" data-confirm="Supprimer définitivement ce ticket ?" data-confirm-titre="Supprimer le ticket">
      <button class="bouton-secondaire danger" type="submit" <%= peutSupprimer ? '' : 'disabled' %> title="<%= peutSupprimer ? 'Supprimer le ticket' : 'Suppression réservée au créateur / CS / admin, uniquement à l\'étape « Créé »' %>">Supprimer</button>
    </form>
  </div>
</div>
<p class="aide"><%= unites.map(u => u.label).join(', ') %> · déclaré le <%= ticket.created_at %></p>

<ol class="metro">
  <% etapes.forEach((e, i) => { %>
    <li class="<%= ticket.etape === e ? 'actuelle' : (etapes.indexOf(ticket.etape) > i ? 'faite' : '') %>">
      <span class="puce"><%= etapes.indexOf(ticket.etape) > i ? '✓' : i + 1 %></span>
      <span class="nom"><%= etiquettes[e] %></span>
    </li>
  <% }) %>
</ol>

<%# ---- Section Description (spec 29) : champ description + unités concernées + photos de création ---- %>
<section class="bloc" id="description">
  <h2>Description</h2>
  <% if (peutEditer) { %>
    <form method="post" action="/tickets/<%= ticket.id %>/editer" class="formulaire" data-autosave>
      <span class="autosave-etat" aria-live="polite"></span>
      <textarea name="description" rows="4" aria-label="Description"><%= ticket.description %></textarea>
    </form>
  <% } else if (ticket.description) { %>
    <p><%= ticket.description %></p>
  <% } %>

  <% if (peutEditerUnites) { %>
    <%# Multiselect « search » (spec 29/30) : mêmes puces + champ texte que le filtre de la liste ; persistance immédiate au changement (spec 27) %>
    <% const unitesOptionsEdit = unitesModifiables.map(u => ({ value: String(u.id), label: u.label + (mesUnites.has(u.id) ? ' (votre unité)' : '') })); %>
    <div class="multiselect unites-edit" id="unites-edit" data-action="/tickets/<%= ticket.id %>/unites" data-options="<%= JSON.stringify(unitesOptionsEdit) %>">
      <div class="multiselect-zone">
        <span class="multiselect-chips" data-chips>
          <% for (const u of unites) { %>
            <span class="chip" data-value="<%= u.id %>"><%= u.label %><button type="button" class="chip-x" data-value="<%= u.id %>" aria-label="Retirer <%= u.label %>">×</button></span>
          <% } %>
        </span>
        <input type="search" placeholder="Ajouter une villa / un garage…" autocomplete="off">
      </div>
      <ul class="multiselect-liste dropdown-liste" hidden></ul>
      <span class="autosave-etat" id="unites-etat" aria-live="polite"></span>
    </div>
  <% } else { %>
    <p><%= unites.map(u => u.label).join(', ') %></p>
  <% } %>

  <%# Photos de la section Description (spec 23/29/31) : ajout/suppression tant que le ticket est « Créé », par toute personne concernée %>
  <% if ((photosParContexte['creation'] || []).length > 0 || peutGererPhotos) { %>
    <h3>Photos</h3>
    <% if (peutGererPhotos) { %>
      <form method="post" action="/tickets/<%= ticket.id %>/photos" class="formulaire" enctype="multipart/form-data" data-autosubmit-photos>
        <div class="bloc-photos">
          <label class="zone-photos">
            <input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple required class="champ-fichiers-caches">
            <span class="zone-photos-plus" aria-hidden="true">+</span>
            <span class="zone-photos-icone" aria-hidden="true">📷</span>
            <span class="zone-photos-texte">Ajouter des photos à la description<br><small>compressées automatiquement avant l'envoi</small></span>
          </label>
          <div class="apercu"></div>
        </div>
      </form>
    <% } %>
    <% if ((photosParContexte['creation'] || []).length > 0) { %>
    <%- include('partials/mosaic', { photos: photosParContexte['creation'] || [], peutSupprimer: peutGererPhotos }) %>
    <% } %>
  <% } %>
</section>

<%# ---- Une seule section de transition à la fois, selon l'état et les droits (spec 20) %>

<% if (ticket.etape === 'cree' && gestionnaire) { %>
<section class="bloc">
  <h2>Passer en consultation</h2>
  <form method="post" action="/tickets/<%= ticket.id %>/passer-consultation" class="formulaire-ligne">
    <button class="bouton" type="submit">Passer en « En consultation »</button>
  </form>
</section>
<% } %>

<%# ---- Consultations (spec 29) : visibles si l'état « consultation » est en cours ou déjà atteint (règle archive incluse) %>
<% if (sections.consultation) { %>
<section class="bloc" id="consultations">
  <h2>Consultations</h2>
  <% if (gestionnaire && ticket.etape === 'consultation') { %>
    <button type="button" class="bouton" id="btn-ajouter-consultation">+ Ajouter une consultation</button>
  <% } %>
  <% if (consultations.length === 0) { %>
    <p class="aide">Aucune consultation pour le moment.</p>
  <% } %>
  <%# Liste de tuples {Entreprise, devis, prix, date d'intervention, bouton de choix} : actives d'abord, caduques ensuite en lecture seule %>
  <ul class="liste-consultations">
  <% for (const c of consultations) { %>
    <li class="consultation <%= c.validee ? 'validee' : '' %> <%= c.caduque ? 'caduque' : '' %>">
      <h3><%= c.raison_sociale %>
        <% if (c.validee && !c.caduque) { %><span class="tag-retenu">VALIDÉE</span><% } %>
        <% if (c.caduque) { %><span class="auteur">🗄 caduque (lecture seule)</span><% } %>
      </h3>
      <p class="aide">
        SIREN/SIRET : <%= c.siren_siret || '—' %> · contact : <%= c.contact_nom || '—' %> · tél : <%= c.ent_telephone || '—' %> · mail : <%= c.ent_mail || '—' %><br>
        Date d'intervention : <strong><%= c.date_planifiee || '—' %></strong> · ajoutée par <%= c.auteur_nom || 'Compte supprimé' %> le <%= c.created_at %>
      </p>
      <ul class="liste-docs">
        <% for (const d of devis.filter(x => x.consultation_id === c.id)) { %>
          <li>
            <a href="/fichiers/<%= d.id %>" target="_blank" rel="noopener">📄 <%= d.nom_original %></a>
            <span class="montant"><%= d.montant != null ? d.montant.toFixed(2) + ' €' : '' %></span>
            <span class="auteur">par <%= d.auteur_nom || 'Compte supprimé' %></span>
          </li>
        <% } %>
      </ul>
      <% if (gestionnaire && ticket.etape === 'consultation' && !c.caduque && !c.validee) { %>
        <details>
          <summary>Modifier cette consultation</summary>
          <form method="post" action="/tickets/<%= ticket.id %>/consultations/<%= c.id %>" class="formulaire" enctype="multipart/form-data">
            <label>Entreprise
              <select name="entreprise_id">
                <% for (const e of entreprises) { %>
                  <option value="<%= e.id %>" <%= e.id === c.entreprise_id ? 'selected' : '' %>><%= e.raison_sociale %></option>
                <% } %>
              </select>
            </label>
            <label>Date planifiée
              <input type="date" name="date_planifiee" value="<%= c.date_planifiee || '' %>">
            </label>
            <label>Ajouter des devis (pièce jointe + montant chacun)
              <input type="file" name="devis_fichiers" accept="image/jpeg,image/png,image/webp,application/pdf" multiple class="champ-fichiers-caches" data-montants="montants-devis-<%= c.id %>">
            </label>
            <div class="montants-devis" id="montants-devis-<%= c.id %>"></div>
            <div class="apercu"></div>
            <button class="bouton-secondaire" type="submit">Enregistrer</button>
          </form>
        </details>
        <form method="post" action="/tickets/<%= ticket.id %>/consultations/<%= c.id %>/supprimer" class="formulaire-ligne" data-confirm="Supprimer cette consultation et ses devis ?" data-confirm-titre="Supprimer la consultation">
          <button class="bouton-secondaire" type="submit">Supprimer la consultation</button>
        </form>
        <form method="post" action="/tickets/<%= ticket.id %>/consultations/<%= c.id %>/valider" class="formulaire-ligne" data-confirm="Valider cette consultation et passer le ticket en « Travaux planifiés » ?" data-confirm-titre="Valider la consultation">
          <button class="bouton" type="submit">Valider cette consultation → Travaux planifiés</button>
        </form>
      <% } %>
    </li>
  <% } %>
  </ul>
  <% if (gestionnaire && ticket.etape === 'consultation') { %>
    <div id="nouvelle-consultation" class="consultation nouvelle" hidden>
    <h3>Nouvelle consultation</h3>
    <form method="post" action="/tickets/<%= ticket.id %>/consultations" class="formulaire" enctype="multipart/form-data">
      <label>Entreprise
        <select name="entreprise_id" id="select-entreprise">
          <option value="">— Choisir une entreprise…</option>
          <% for (const e of entreprises) { %>
            <option value="<%= e.id %>"><%= e.raison_sociale %></option>
          <% } %>
          <option value="nouvelle">➕ Créer une nouvelle entreprise</option>
        </select>
      </label>
      <%# Fiche « à la volée » : saisie dans la modale (spec 29), valeurs recopiées ici à la validation %>
      <fieldset id="fiche-nouvelle-entreprise" hidden>
        <input type="text" name="nouvelle_raison_sociale">
        <input type="text" name="nouveau_siren_siret">
        <input type="text" name="nouveau_contact_nom">
        <input type="tel" name="nouveau_telephone">
        <input type="email" name="nouveau_mail">
      </fieldset>
      <label>Date d'intervention (obligatoire)
        <input type="date" name="date_planifiee" required>
      </label>
      <label>Devis (au moins un : pièce jointe + montant)
        <input type="file" name="devis_fichiers" accept="image/jpeg,image/png,image/webp,application/pdf" multiple required class="champ-fichiers-caches" data-montants="montants-devis-new">
      </label>
      <div class="montants-devis" id="montants-devis-new"></div>
      <p class="aide">Un champ de montant apparaît pour chaque fichier choisi, dans le même ordre.</p>
      <div class="apercu"></div>
      <button class="bouton" type="submit">Ajouter la consultation</button>
    </form>
    </div>
  <% } %>
</section>

<%# ---- Modale « créer une nouvelle entreprise » : la fiche à la volée s'y affiche, pas dans la page (spec 29) %>
<% if (gestionnaire && ticket.etape === 'consultation') { %>
<div class="modale-fond" id="modale-entreprise" hidden>
  <div class="modale" role="dialog" aria-modal="true" aria-labelledby="modale-entreprise-titre">
    <h2 id="modale-entreprise-titre">Nouvelle entreprise</h2>
    <form id="form-nouvelle-entreprise" class="formulaire">
      <label>Raison sociale (obligatoire)
        <input type="text" id="me-raison" required>
      </label>
      <label>SIREN/SIRET
        <input type="text" id="me-siren">
      </label>
      <label>Nom du contact
        <input type="text" id="me-contact">
      </label>
      <label>Téléphone
        <input type="tel" id="me-tel">
      </label>
      <label>Email
        <input type="email" id="me-mail">
      </label>
      <div class="modale-actions">
        <button type="button" id="modale-entreprise-annuler" class="bouton-secondaire">Annuler</button>
        <button type="button" id="modale-entreprise-valider" class="bouton">Créer et utiliser</button>
      </div>
    </form>
  </div>
</div>
<% } %>
<% } %>

<%# ---- Bilans : visibles si « Travaux planifiés » est en cours ou déjà atteint (spec 29), UNIQUEMENT aux personnes concernées (spec 28) %>
<% if (sections.bilans && peutVoirCR) { %>
<section class="bloc" id="cr">
  <h2>Bilans de l’intervention</h2>

  <%# Acceptations matérialisées en pastilles dans le bilan (spec 30), comme les demandes de rattachement dans la page de compte %>
  <% if (validations.length > 0) { %>
    <ul class="liste-rattachements">
      <% for (const v of validations) { %>
        <li class="rattachement-pill statut-<%= v.caduque ? 'refuse' : 'accepte' %>">
          <span class="unite-num"><%= v.auteur_nom || 'Compte supprimé' %></span>
          <% if (v.caduque) { %><span class="unite-statut refuse">📄 caduque (lecture seule)</span>
          <% } else { %><span class="unite-statut valide">✅ a accepté</span><% } %>
          <% if (v.commentaire) { %><span class="unite-qualite">« <%= v.commentaire %> »</span><% } %>
        </li>
      <% } %>
    </ul>
  <% } %>
  <%- include('partials/mosaic', { photos: photosParContexte['validation'] || [], peutSupprimer: false }) %>

  <%# En « Travaux acceptés » : date d'archivage automatique + réouverture (spec 20), désormais dans la section Bilans (spec 30) %>
  <% if (ticket.etape === 'travaux_acceptes') { %>
    <% if (dateArchivageAuto) { %>
      <p class="aide">Archivage automatique prévu le <strong><%= dateArchivageAuto.toISOString().slice(0, 10) %></strong> (après <%= delaiArchivageJours %> jours en « Travaux acceptés »).</p>
    <% } %>
    <% if (peutReouvrir) { %>
      <h3>Réouvrir le ticket</h3>
      <p class="aide">Possible pendant <%= delaiArchivageJours %> jours après le passage en « Travaux acceptés ». Un commentaire et au moins une photo sont obligatoires. Le ticket repasse en consultation ; les consultations et validations précédentes deviennent caduques (conservées en lecture seule).</p>
      <form method="post" action="/tickets/<%= ticket.id %>/reouvrir" class="formulaire" enctype="multipart/form-data">
        <label>Commentaire (obligatoire)
          <input type="text" name="commentaire" required placeholder="Pourquoi rouvrir ce ticket ?">
        </label>
        <div class="bloc-photos">
          <label class="zone-photos">
            <input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple required class="champ-fichiers-caches">
            <span class="zone-photos-plus" aria-hidden="true">+</span>
            <span class="zone-photos-icone" aria-hidden="true">📷</span>
            <span class="zone-photos-texte">Au moins une photo (obligatoire)<br><small>compressées automatiquement avant l'envoi</small></span>
          </label>
          <div class="apercu"></div>
        </div>
        <button class="bouton" type="submit">Réouvrir le ticket</button>
      </form>
    <% } %>
    <% if ((photosParContexte['reouverture'] || []).length > 0) { %>
      <h3>Photos de réouverture</h3>
      <%- include('partials/mosaic', { photos: photosParContexte['reouverture'] || [], peutSupprimer: false }) %>
    <% } %>
  <% } %>

  <%# Bilans du cycle en cours : zone d'édition pour soi (uniquement en « Travaux planifiés »), lecture seule pour les autres personnes concernées (spec 28) %>
  <% const cycleCourant = ticket.cycle || 1; %>
  <% const crsCycle = comptesRendus.filter(cr => (cr.cycle || 1) === cycleCourant); %>
  <% const anciensCycles = [...new Set(comptesRendus.map(cr => cr.cycle || 1))].filter(c => c < cycleCourant).sort((a, b) => b - a); %>
  <% for (const p of personnesCR) { const cr = crsCycle.find(x => x.user_id === p.id); %>
  <div class="bilan-pers">
    <h3><%= p.prenom %> <%= p.nom %><% if (p.conseil_syndical === 1) { %> <span class="tag-cs">CS</span><% } %></h3>
    <% if (cr && cr.contenu) { %><p><%= cr.contenu %></p><p class="aide">rédigé le <%= cr.updated_at %></p><% } %>
    <% const photosP = (photosCRParCycle[cycleCourant] || []).filter(f => f.auteur_id === p.id); %>
    <%- include('partials/mosaic', { photos: photosP, peutSupprimer: peutRedigerCR && p.id === user.id }) %>
    <% if (peutRedigerCR && p.id === user.id) { %>
      <form method="post" action="/tickets/<%= ticket.id %>/cr" class="formulaire" enctype="multipart/form-data" data-autosave>
        <label>Votre bilan <span class="autosave-etat" aria-live="polite"></span>
          <textarea name="contenu" rows="3" placeholder="Votre bilan de l’intervention…"><%= cr ? cr.contenu : '' %></textarea>
        </label>
        <div class="bloc-photos">
          <label class="zone-photos">
            <input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple class="champ-fichiers-caches">
            <span class="zone-photos-plus" aria-hidden="true">+</span>
            <span class="zone-photos-icone" aria-hidden="true">📷</span>
            <span class="zone-photos-texte">Ajouter des photos avec le bilan<br><small>compressées automatiquement avant l’envoi</small></span>
          </label>
          <div class="apercu"></div>
        </div>
        <%# Spec 31 : UNE seule zone commentaire + photos ; Accepter / Refuser côte à côte soumettent cette même zone %>
        <% if (ticket.etape === 'intervention_planifiee' && peutAccepterRefuser) { %>
          <div class="actions-acceptation">
            <button type="submit" class="bouton" formaction="/tickets/<%= ticket.id %>/accepter" data-confirm="Accepter les travaux ? Dès l’acceptation, le ticket passe à « Travaux acceptés » et cette section passe en lecture seule." data-confirm-titre="Accepter les travaux">Accepter</button>
            <button type="submit" class="bouton danger" formaction="/tickets/<%= ticket.id %>/refuser" data-confirm="Refuser les travaux ? Le ticket repassera en « En consultation » : les consultations et acceptations précédentes seront caduques et les bilans figés en lecture seule." data-confirm-titre="Refuser les travaux">Refuser</button>
          </div>
        <% } %>
      </form>
    <% } %>
  </div>
  <% } %>

  <%# Bilans des cycles précédents : repliés par défaut, titre = date du changement d'état (spec 32) %>
  <% const retours = evenements.filter(e => e.type === 'changement_etape' && (e.donnees || '').includes('"etape":"consultation"')); %>
  <% const dateFinCycle = {}; anciensCycles.forEach(c => { dateFinCycle[c] = (retours[c - 1] && retours[c - 1].created_at) || ''; }); %>
  <% if (anciensCycles.length > 0) { %>
  <details class="bilans-anciens">
    <summary>Bilans des cycles précédents<% if (retours.length > 0) { %> — changement d’état le <%= retours[retours.length - 1].created_at %><% } %></summary>
    <% for (const c of anciensCycles) { %>
    <div class="bilan-pers">
      <h4>Cycle <%= c %> — figé<% if (dateFinCycle[c]) { %> le <%= dateFinCycle[c] %><% } %> (lecture seule)</h4>
      <% for (const p of personnesCR) { const cr = comptesRendus.find(x => x.user_id === p.id && (x.cycle || 1) === c); %>
        <% if (cr) { %>
          <h4><%= p.prenom %> <%= p.nom %></h4>
          <% if (cr.contenu) { %><p><%= cr.contenu %></p><p class="aide">rédigé le <%= cr.updated_at %></p><% } %>
        <% } %>
        <% const photosC = (photosCRParCycle[c] || []).filter(f => f.auteur_id === p.id); %>
        <%- include('partials/mosaic', { photos: photosC, peutSupprimer: false }) %>
      <% } %>
    </div>
    <% } %>
  </details>
  <% } %>
</section>
<% } %>

<%# ---- Factures (spec 29) : UNIQUEMENT en « Travaux acceptés », ou en « Archivé » si l'état a déjà été connu (alors lecture seule) %>
<% if (sections.factures) { %>
<section class="bloc" id="factures">
  <h2>Factures</h2>
  <% if (factures.length === 0) { %>
    <p class="aide">Aucune facture pour le moment.</p>
  <% } else { %>
    <ul class="liste-docs">
      <% for (const f of factures) { %>
        <li>
          <a href="/fichiers/<%= f.id %>" target="_blank" rel="noopener">📄 <%= f.nom_original %></a>
          <span class="montant"><%= f.montant != null ? f.montant.toFixed(2) + ' €' : '' %></span>
          <span class="auteur">par <%= f.auteur_nom || 'Compte supprimé' %></span>
        </li>
      <% } %>
    </ul>
  <% } %>
  <% if (gestionnaire && ticket.etape === 'travaux_acceptes') { %>
    <form method="post" action="/tickets/<%= ticket.id %>/factures" class="formulaire" enctype="multipart/form-data">
      <label>Facture (PDF)
        <input type="file" name="fichier" accept="application/pdf" required class="champ-fichiers-visible">
      </label>
      <label>Coût (€)
        <input type="number" name="montant" min="0.01" step="0.01" required>
      </label>
      <button class="bouton-secondaire" type="submit">Ajouter la facture</button>
    </form>
  <% } %>
</section>
<% } %>

<section class="bloc" id="fil">
  <h2>Fil de suivi</h2>
  <ul class="fil">
    <% for (const e of evenements) { %>
      <li><span class="date"><%= e.created_at %></span> <strong><%= e.auteur_nom || 'Système' %></strong> — <%= e.contenu %></li>
    <% } %>
  </ul>
</section>
<%- include('partials/footer') %>
