<%- include('partials/header', { titre: 'Tickets' }) %>
<div class="entete-page">
  <h1>Tickets</h1>
  <a class="bouton" href="/tickets/nouveau">+ Nouveau ticket</a>
</div>
<% if (mesUnites.length === 0) { %>
  <p class="aide">Votre rattachement à une villa ou un garage n'est pas encore accepté : vous ne pouvez voir aucun ticket ni en déclarer pour le moment. <a href="/rattachements">Voir mes rattachements</a></p>
<% } %>
<%# Recherche plaintext à la volée, côté client, sans rechargement (garde le focus) : hors du formulaire %>
<input type="search" id="recherche-tickets" class="recherche recherche-pleine" placeholder="Rechercher un ticket (titre, description)…" value="<%= filtres.q || '' %>" autocomplete="off">
<form method="get" action="/tickets" id="filtres-tickets">
  <div class="filtres">
  <%# Multiselect « search » des unités (spec 29) : champ texte + dropdown des 5 premiers résultats, puces à gauche %>
  <div class="dropdown" data-filtre="etape">
    <button type="button" class="dropdown-bouton" aria-expanded="false">
      <span class="dropdown-valeur"><%= filtres.etape ? etiquettes[filtres.etape] : 'Tous les états (hors archivés)' %></span> ▾
    </button>
    <ul class="dropdown-liste" hidden>
      <li><button type="button" class="dropdown-option <%= !filtres.etape ? 'selectionne' : '' %>" data-value="">Tous les états (hors archivés)</button></li>
      <% for (const e of etapes) { %>
        <li><button type="button" class="dropdown-option <%= filtres.etape === e ? 'selectionne' : '' %>" data-value="<%= e %>"><%= etiquettes[e] %></button></li>
      <% } %>
    </ul>
    <input type="hidden" name="etape" value="<%= filtres.etape || '' %>">
  </div>
  <div class="multiselect" id="filtre-unites" data-options="<%= JSON.stringify(unitesOptions) %>">
    <div class="multiselect-zone">
      <span class="multiselect-chips" id="unites-chips">
        <% for (const v of unitesSelectionnees) { const opt = unitesOptions.find(o => o.value === v); %>
          <span class="chip" data-value="<%= opt.value %>"><%= opt.label %><button type="button" class="chip-x" data-value="<%= opt.value %>" aria-label="Retirer <%= opt.label %>">×</button></span>
        <% } %>
      </span>
      <input type="search" id="recherche-unite" placeholder="<%= mesUnites.length > 0 ? 'Filtrer par villa / garage… (défaut : mes unités)' : 'Filtrer par villa / garage…' %>" autocomplete="off">
    </div>
    <ul class="multiselect-liste dropdown-liste" id="unites-liste" hidden></ul>
    <span class="multiselect-hidden" id="unites-hidden">
      <% for (const v of unitesSelectionnees) { %><input type="hidden" name="unite" value="<%= v %>"><% } %>
    </span>
  </div>
  <label class="case"><input type="checkbox" name="urgent" value="1" <%= filtres.urgent === '1' ? 'checked' : '' %>> Urgents</label>
  </div>
</form>
<% if (tickets.length === 0) { %>
  <p class="aide">Aucun ticket pour le moment.</p>
<% } %>
<p class="aide" id="recherche-aucun-tickets" hidden>Aucun ticket ne correspond à cette recherche.</p>
<ul class="liste-tickets" id="liste-tickets">
  <% for (const t of tickets) { %>
    <li class="carte-ticket <%= t.urgent ? 'urgent' : '' %>" data-recherche="<%= (t.titre + ' ' + (t.description || '')).toLowerCase() %>">
      <a href="/tickets/<%= t.id %>">
        <div class="ligne1">
          <strong><%= t.titre %></strong>
          <% if (t.urgent) { %><span class="tag-urgent">URGENT</span><% } %>
        </div>
        <div class="ligne2">
          <span class="ligne2-gauche">
            <span class="mini-metro" aria-hidden="true">
              <% const idxEtape = etapes.indexOf(t.etape); etapes.forEach((e, i) => { %>
                <span class="mini-puce <%= t.etape === e ? 'etape-' + e : (idxEtape > i ? 'faite' : '') %>"></span>
                <% if (i < etapes.length - 1) { %><span class="mini-lien"></span><% } %>
              <% }) %>
            </span>
            <span class="tag-etape etape-<%= t.etape %>"><%= etiquettes[t.etape] %></span>
          </span>
          <span class="ligne2-unites"><%= t.unites || '' %></span>
        </div>
      </a>
    </li>
  <% } %>
</ul>
<%- include('partials/footer') %>
