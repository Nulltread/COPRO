<%- include('partials/header', { titre: 'Tickets' }) %>
<div class="entete-page">
  <h1>Tickets</h1>
  <a class="bouton" href="/tickets/nouveau">+ Nouveau ticket</a>
</div>
<% if (mesUnites.length === 0) { %>
  <p class="aide">Votre rattachement à une villa ou un garage n'est pas encore accepté : vous ne pouvez voir aucun ticket ni en déclarer pour le moment. <a href="/rattachements">Voir mes rattachements</a></p>
<% } %>
<form method="get" action="/tickets" class="filtres">
  <select name="etape">
    <option value="">Tous les états (hors archivés)</option>
    <% for (const e of etapes) { %>
      <option value="<%= e %>" <%= filtres.etape === e ? 'selected' : '' %>><%= etiquettes[e] %></option>
    <% } %>
  </select>
  <select name="unite">
    <% if (mesUnites.length > 0) { %>
      <option value="" <%= !filtres.unite ? 'selected' : '' %>>Mes unités (défaut)</option>
    <% } %>
    <option value="toutes" <%= filtres.unite === 'toutes' ? 'selected' : '' %>>Toutes les unités</option>
    <% for (const u of unitesFiltre) { %>
      <option value="<%= u.id %>" <%= String(filtres.unite) === String(u.id) ? 'selected' : '' %>><%= u.label %></option>
    <% } %>
  </select>
  <input type="number" name="cout_min" min="0" step="0.01" placeholder="Coût min (€)" value="<%= filtres.cout_min || '' %>" style="max-width:130px">
  <label class="case"><input type="checkbox" name="urgent" value="1" <%= filtres.urgent === '1' ? 'checked' : '' %>> Urgents</label>
  <button class="bouton-secondaire" type="submit">Filtrer</button>
</form>
<% if (tickets.length === 0) { %>
  <p class="aide">Aucun ticket pour le moment.</p>
<% } %>
<ul class="liste-tickets">
  <% for (const t of tickets) { %>
    <li class="carte-ticket <%= t.urgent ? 'urgent' : '' %>">
      <a href="/tickets/<%= t.id %>">
        <div class="ligne1">
          <strong><%= t.titre %></strong>
          <% if (t.urgent) { %><span class="tag-urgent">URGENT</span><% } %>
        </div>
        <div class="ligne2">
          <span class="ligne2-gauche">
            <span class="mini-metro" aria-hidden="true">
              <% const idxEtape = etapes.indexOf(t.etape); etapes.forEach((e, i) => { %>
                <span class="mini-puce <%= t.etape === e ? 'etape-' + e : (idxEtape > i ? 'faite' : '') %>"></span>
                <% if (i < etapes.length - 1) { %><span class="mini-lien"></span><% } %>
              <% }) %>
            </span>
            <span class="tag-etape etape-<%= t.etape %>"><%= etiquettes[t.etape] %></span>
          </span>
          <span class="ligne2-unites"><%= t.unites || '' %></span>
        </div>
      </a>
    </li>
  <% } %>
</ul>
<%- include('partials/footer') %>
