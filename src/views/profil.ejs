<%- include('partials/header', { titre: 'Mon profil' }) %>
<h1>Mon profil</h1>
<% if (message) { %><p class="info"><%= message %></p><% } %>
<p><strong><%= user.prenom %> <%= user.nom %></strong> — <%= user.email %> — <%= user.telephone %>
  <% if (user.conseil_syndical === 1) { %>— <span class="tag-cs">membre du conseil syndical</span><% } %>
  <% if (user.role === 'admin') { %>— administrateur<% } %></p>
<% if (mesUnites.length) { %>
<ul class="liste-simple">
  <% for (const u of mesUnites) { %>
    <li><%= u.label %> (<%= u.qualite %>)<% if (u.type !== 'communes') { %>
      <form method="post" action="/profil/retirer-unite" class="formulaire-ligne">
        <input type="hidden" name="unit_id" value="<%= u.id %>">
        <button class="bouton-secondaire" type="submit" title="Se retirer de cette unité (sans impact sur les tickets)">se retirer</button>
      </form><% } %>
    </li>
  <% } %>
</ul>
<% } else { %>
  <p class="aide">Vous n'êtes rattaché à aucune unité pour le moment : vous ne pouvez pas encore déclarer de ticket.</p>
<% } %>
<form method="post" action="/profil" class="formulaire">
  <label>Nom
    <input type="text" name="nom" value="<%= user.nom %>" required>
  </label>
  <label>Prénom
    <input type="text" name="prenom" value="<%= user.prenom %>" required>
  </label>
  <label>Téléphone
    <input type="tel" name="telephone" value="<%= user.telephone %>" required>
  </label>
  <label>Nouveau mot de passe (laisser vide pour ne pas changer)
    <input type="password" name="motdepasse" minlength="8" autocomplete="new-password">
  </label>
  <button class="bouton" type="submit">Enregistrer</button>
</form>
<section class="bloc">
  <h2>Mes rattachements</h2>
  <p><a class="bouton-secondaire" href="/rattachements">Voir l'état de mes rattachements</a></p>
</section>
<section class="bloc">
  <h2>Rattacher une autre unité</h2>
  <form method="post" action="/profil/reclamer" class="formulaire-ligne">
    <select name="unite_id" required>
      <option value="">— Choisir une villa ou un garage —</option>
      <% for (const u of unitesReclamables) { %>
        <option value="<%= u.id %>"><%= u.label %></option>
      <% } %>
    </select>
    <select name="qualite">
      <option value="proprietaire">Propriétaire</option>
      <option value="locataire">Locataire</option>
    </select>
    <button class="bouton-secondaire" type="submit">Réclamer le rattachement</button>
  </form>
  <p class="aide">La demande sera acceptée par un résident de l'unité ou par le conseil syndical.</p>
</section>
<section class="bloc">
  <h2>Mes données (RGPD)</h2>
  <p><a class="bouton-secondaire" href="/profil/export">📥 Télécharger mes données (JSON)</a></p>
  <form method="post" action="/profil/supprimer" onsubmit="return confirm('Supprimer définitivement mon compte ? Cette action est irréversible. Vos tickets restent attachés à leur unité.');">
    <button class="bouton-secondaire">🗑 Supprimer mon compte</button>
  </form>
</section>
<form method="post" action="/deconnexion"><button class="bouton-secondaire">Se déconnecter</button></form>
<%- include('partials/footer') %>
