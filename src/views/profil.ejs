<%- include('partials/header', { titre: 'Mon profil' }) %>
<h1>Mon profil</h1>
<% if (message) { %><p class="info"><%= message %></p><% } %>
<% if (erreur) { %><p class="erreur"><%= erreur %></p><% } %>
<p><strong><%= user.prenom %> <%= user.nom %></strong> — <%= user.email %> — <%= user.telephone %>
  <% if (user.conseil_syndical === 1) { %>— <span class="tag-cs">membre du conseil syndical</span><% } %>
  <% if (user.email_verifie === 1) { %> — <span class="tag-cs">email vérifié</span><% } else { %> — <strong>email non vérifié</strong>
    <form method="post" action="/profil/renvoyer-confirmation" class="formulaire-ligne">
      <button class="bouton-secondaire" type="submit">Renvoyer l'email de validation</button>
    </form><% } %>
<% if (user.role === 'admin') { %>— administrateur<% } %></p>
<% if (mesUnites.length) { %>
<ul class="liste-simple">
  <% for (const u of mesUnites) { %>
    <li><%= u.label %> (<%= u.qualite === 'proprietaire' ? 'propriétaire (via mon lot)' : 'locataire' %>)<% if (u.type !== 'communes' && u.qualite === 'locataire') { %>
      <form method="post" action="/profil/retirer-unite" class="formulaire-ligne" data-confirm="Annuler votre rattachement à « <%= u.label %> » ? Vous ne serez plus rattaché à cette unité (sans impact sur les tickets)." data-confirm-titre="Annuler le rattachement">
        <input type="hidden" name="unit_id" value="<%= u.id %>">
        <button class="bouton-secondaire" type="submit" title="Se retirer de cette unité (sans impact sur les tickets)">se retirer</button>
      </form><% } %>
    </li>
  <% } %>
</ul>
<% } else { %>
  <p class="aide">Vous n'êtes rattaché à aucune unité pour le moment : vous ne pouvez pas encore déclarer de ticket.</p>
<% } %>
<form method="post" action="/profil" class="formulaire">
  <label>Nom
    <input type="text" name="nom" value="<%= user.nom %>" required>
  </label>
  <label>Prénom
    <input type="text" name="prenom" value="<%= user.prenom %>" required>
  </label>
  <label>Téléphone
    <input type="tel" name="telephone" value="<%= user.telephone %>" required>
  </label>
  <label>Nouveau mot de passe (laisser vide pour ne pas changer)
    <input type="password" name="motdepasse" minlength="8" autocomplete="new-password">
  </label>
  <label>
    <input type="checkbox" name="notif_email" value="1" <%= user.notif_email === 1 ? 'checked' : '' %>>
    Recevoir aussi les notifications par email (en plus de l'application)
  </label>
  <button class="bouton" type="submit">Enregistrer</button>
</form>
<section class="bloc">
  <h2>Mes rattachements</h2>
  <% if (mesRattachements.length === 0) { %>
    <p class="aide">Aucune demande pour le moment.</p>
  <% } else { %>
    <ul class="liste-rattachements">
      <% for (const r of mesRattachements) { %>
        <li class="rattachement-pill statut-<%= r.statut %>">
          <span class="unite-type"><%= r.unite_type === 'villa' ? 'Villa' : (r.unite_type === 'garage' ? 'Garage' : 'Parties communes') %></span>
          <span class="unite-num"><%= r.unite_numero != null ? r.unite_numero : '—' %></span>
          <span class="unite-qualite"><%= r.qualite %></span>
          <% if (r.statut === 'en_attente') { %>
            <span class="unite-statut en-attente">⏳ en attente</span>
            <form method="post" action="/profil/rattachements/<%= r.id %>/annuler" class="formulaire-ligne" data-confirm="Annuler votre demande de rattachement à « <%= r.unite_label %> » ?" data-confirm-titre="Annuler la demande">
              <button class="bouton-secondaire" type="submit">annuler la demande</button>
            </form>
          <% } else if (r.statut === 'accepte') { %>
            <span class="unite-statut valide">✅ validé</span>
          <% } else { %>
            <span class="unite-statut refuse">❌ refusé</span>
          <% } %>
        </li>
      <% } %>
    </ul>
  <% } %>
  <p class="aide">L'état des demandes à valider se suit depuis les notifications.</p>
</section>
<section class="bloc">
  <h2>Rattacher une autre unité</h2>
  <form method="post" action="/profil/reclamer" class="formulaire-ligne">
    <span class="titre-champ">Villa / garage&nbsp;<span class="req" aria-hidden="true">*</span></span>
    <select name="unite_id" required aria-label="Villa ou garage">
      <option value="">— Choisir une villa ou un garage —</option>
      <% for (const u of unitesReclamables) { %>
        <option value="<%= u.id %>"><%= u.label %></option>
      <% } %>
    </select>
    <button class="bouton-secondaire" type="submit">Réclamer le rattachement (locataire)</button>
  </form>
  <p class="aide">La demande (toujours en tant que locataire) sera acceptée par un résident de l'unité ou par le conseil syndical.</p>
</section>
<% if (mesLots.length) { %>
<section class="bloc">
  <h2>Mes lots</h2>
  <ul class="liste-simple">
    <% for (const l of mesLots) { %>
      <li>
        <strong>Lot <%= l.numero %></strong> — <%= l.designation %> (<%= l.type_lot %>) — tantièmes : <%= l.tantiemes %> — unités : <%= l.unites || 'aucune' %>
        <% if (unitesLibres.length) { %>
          <form method="post" action="/profil/lots/<%= l.id %>/demander-unite" class="formulaire-ligne" data-confirm="Demander l'ajout d'une unité à mon lot <%= l.numero %> ?" data-confirm-titre="Ajouter une unité au lot">
            <select name="unite_id" required aria-label="Unité à ajouter au lot">
              <option value="">— Choisir une unité libre —</option>
              <% for (const u of unitesLibres) { %>
                <option value="<%= u.id %>"><%= u.label %></option>
              <% } %>
            </select>
            <button class="bouton-secondaire" type="submit">demander l'ajout</button>
          </form>
        <% } %>
      </li>
    <% } %>
  </ul>
  <% if (mesDemandesLot.length) { %>
    <ul class="liste-rattachements">
      <% for (const d of mesDemandesLot) { %>
        <li class="rattachement-pill statut-<%= d.statut %>">
          Lot <%= d.lot_numero %> — <%= d.unite_label %>
          <% if (d.statut === 'en_attente') { %>
            <span class="unite-statut en-attente">⏳ en attente</span>
            <form method="post" action="/profil/lots-demandes/<%= d.id %>/annuler" class="formulaire-ligne" data-confirm="Annuler cette demande ?" data-confirm-titre="Annuler la demande">
              <button class="bouton-secondaire" type="submit">annuler la demande</button>
            </form>
          <% } else if (d.statut === 'accepte') { %>
            <span class="unite-statut valide">✅ validé</span>
          <% } else { %>
            <span class="unite-statut refuse">❌ refusé</span>
          <% } %>
        </li>
      <% } %>
    </ul>
  <% } %>
  <p class="aide">L'ajout d'une unité à un lot est examiné par le conseil syndical. Le retrait d'une unité d'un lot se fait depuis l'onglet Lots (CS/admin).</p>
</section>
<% } %>
<%# Section raccourci écran d'accueil (spec 15) : sans titre (spec 29) %>
<section class="bloc" id="install">
  <div id="install-etat"></div>
</section>
<section class="bloc">
  <h2>Mes données (RGPD)</h2>
  <p><a class="bouton-secondaire" href="/profil/export">📥 Télécharger mes données (JSON)</a></p>
  <form method="post" action="/profil/supprimer" onsubmit="return confirm('Supprimer définitivement mon compte ? Cette action est irréversible. Vos tickets restent attachés à leur unité.');">
    <button class="bouton-secondaire">🗑 Supprimer mon compte</button>
  </form>
</section>
<form method="post" action="/deconnexion"><button class="bouton-secondaire">Se déconnecter</button></form>
<%- include('partials/footer') %>
