<%- include('partials/header', { user: null, titre: 'Inscription' }) %>
<h1>Créer un compte</h1>
<p class="aide">Réservé aux copropriétaires et locataires d'une villa ou d'un garage. Vous réclamez votre rattachement à une unité : il sera accepté par un résident de cette unité ou par le conseil syndical. Tant qu'il n'est pas accepté, vous ne pouvez pas déclarer de ticket.</p>
<% if (erreur) { %><p class="erreur"><%= erreur %></p><% } %>
<form method="post" action="/inscription" class="formulaire">
  <label>Nom
    <input type="text" name="nom" required autocomplete="family-name">
  </label>
  <label>Prénom
    <input type="text" name="prenom" required autocomplete="given-name">
  </label>
  <label>Téléphone
    <input type="tel" name="telephone" required autocomplete="tel">
  </label>
  <label>Votre email (identifiant de connexion)
    <input type="email" name="email" required autocomplete="email">
  </label>
  <label>Mot de passe (8 caractères min.)
    <input type="password" name="motdepasse" required minlength="8" autocomplete="new-password">
  </label>
  <label>Villa ou garage auquel vous souhaitez être rattaché
    <select name="unite_id" required>
      <option value="">— Choisir —</option>
      <% for (const u of units) { %>
        <option value="<%= u.id %>"><%= u.label %></option>
      <% } %>
    </select>
  </label>
  <label>Vous êtes
    <select name="qualite">
      <option value="proprietaire">Propriétaire</option>
      <option value="locataire">Locataire</option>
    </select>
  </label>
  <button type="submit" class="bouton">Créer mon compte</button>
</form>
<p><a href="/connexion">Déjà un compte ? Se connecter</a></p>
<%- include('partials/footer') %>
