<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#24466B">
  <title><%= typeof titre !== 'undefined' ? titre + ' — ' : '' %>Copro La Pinède de Notre Dame</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="/icon.svg?v=3" type="image/svg+xml">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Copro">
  <link rel="apple-touch-icon" href="/icon-192.png?v=3">
</head>
<body>
<% if (user) { %>
<header class="barre">
  <a class="marque" href="/tickets"><svg class="marque-icone" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12 L12 4 L21 12" fill="none" stroke="#24466B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M6.5 15.5 L12 10 L17.5 15.5" fill="none" stroke="#24466B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.85"/></svg>Copro La Pinède de Notre Dame</a>
  <nav class="nav nav-desktop" aria-label="Navigation principale">
    <a href="/tickets">Tickets</a>
    <a href="/documents">Documents</a>
    <% if (user.conseil_syndical === 1 || user.role === 'admin') { %>
      <a href="/tableau-de-bord">Tableau de bord</a>
      <a href="/admin/comptes">Comptes</a>
      <a href="/admin/lots">Lots</a>
      <a href="/entreprises">Entreprises</a>
    <% } %>
    <% if (user.role === 'admin') { %>
      <a href="/admin">Administration</a>
      <a href="/admin/usage">Usage</a>
    <% } %>
    <a href="/profil">👤 <%= user.prenom || user.nom %><% if (user.conseil_syndical === 1) { %> <span class="tag-cs">CS</span><% } %></a>
  </nav>
  <div class="barre-droite">
    <a href="/aide?depuis=<%= encodeURIComponent(typeof cheminCourant !== 'undefined' ? cheminCourant : '/') %>" class="nav-aide" aria-label="Aide en ligne" title="Aide en ligne">?</a>
    <a href="/notifications" class="nav-notif" aria-label="Notifications">🔔<% if (nonLues > 0) { %><span class="badge"><%= nonLues %></span><% } %></a>
    <a href="/tickets/nouveau" class="bouton-nav nav-creation">+ Nouveau ticket</a>
    <button type="button" id="menu-burger" class="menu-burger" aria-expanded="false" aria-controls="menu-panneau" aria-label="Ouvrir le menu">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
    </button>
  </div>
  <nav id="menu-panneau" class="menu-panneau" hidden aria-label="Menu">
    <a href="/tickets/nouveau" class="bouton-nav">+ Nouveau ticket</a>
    <a href="/tickets">Tickets</a>
    <a href="/documents">Documents</a>
    <% if (user.conseil_syndical === 1 || user.role === 'admin') { %>
      <a href="/tableau-de-bord">Tableau de bord</a>
      <a href="/admin/comptes">Comptes</a>
      <a href="/admin/lots">Lots</a>
      <a href="/entreprises">Entreprises</a>
    <% } %>
    <% if (user.role === 'admin') { %>
      <a href="/admin">Administration</a>
      <a href="/admin/usage">Usage</a>
    <% } %>
    <a href="/profil">👤 <%= user.prenom || user.nom %><% if (user.conseil_syndical === 1) { %> <span class="tag-cs">CS</span><% } %></a>
    <a href="/aide?depuis=<%= encodeURIComponent(typeof cheminCourant !== 'undefined' ? cheminCourant : '/') %>">❓ Aide</a>
  </nav>
</header>
<% } %>
<main class="contenu">
