<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#1a5fb4">
  <title><%= typeof titre !== 'undefined' ? titre + ' — ' : '' %>Copro des Pavillons</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
</head>
<body>
<% if (user) { %>
<header class="barre">
  <a class="marque" href="/tickets">🏠 Copro des Pavillons</a>
  <nav class="nav">
    <a href="/tickets">Tickets</a>
    <a href="/tickets/nouveau" class="bouton-nav">+ Nouveau</a>
    <a href="/notifications" class="nav-notif">🔔<% if (nonLues > 0) { %><span class="badge"><%= nonLues %></span><% } %></a>
    <% if (user.role === 'syndic' || user.role === 'conseil' || user.role === 'admin') { %>
      <a href="/tableau-de-bord">Tableau de bord</a>
    <% } %>
    <% if (user.role === 'admin') { %>
      <a href="/admin/unites">Unités</a>
    <% } %>
    <% if (user.role === 'syndic' || user.role === 'conseil' || user.role === 'admin') { %>
      <a href="/admin/comptes">Comptes</a>
    <% } %>
    <a href="/profil">👤 <%= user.nom %></a>
  </nav>
</header>
<% } %>
<main class="contenu">
