<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#9C4A2F">
  <title><%= typeof titre !== 'undefined' ? titre + ' — ' : '' %>Copro La Pinède de Notre Dame</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Copro">
  <link rel="apple-touch-icon" href="/icon-192.png">
</head>
<body>
<% if (user) { %>
<header class="barre">
  <a class="marque" href="/tickets"><svg class="marque-icone" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12 L12 4 L21 12" fill="none" stroke="#9C4A2F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M6.5 15.5 L12 10 L17.5 15.5" fill="none" stroke="#9C4A2F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.85"/></svg>Copro La Pinède de Notre Dame</a>
  <nav class="nav">
    <a href="/tickets">Tickets</a>
    <a href="/tickets/nouveau" class="bouton-nav">+ Nouveau ticket</a>
    <a href="/notifications" class="nav-notif">🔔<% if (nonLues > 0) { %><span class="badge"><%= nonLues %></span><% } %></a>
    <% if (user.conseil_syndical === 1 || user.role === 'admin') { %>
      <a href="/tableau-de-bord">Tableau de bord</a>
    <% } %>
    <% if (user.conseil_syndical === 1 || user.role === 'admin') { %>
      <a href="/admin/comptes">Comptes</a>
      <a href="/entreprises">Entreprises</a>
    <% } %>
    <% if (user.role === 'admin') { %>
      <a href="/admin">Administration</a>
    <% } %>
    <a href="/profil">👤 <%= user.prenom || user.nom %><% if (user.conseil_syndical === 1) { %> <span class="tag-cs">CS</span><% } %></a>
  </nav>
</header>
<% } %>
<main class="contenu">
