<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#1a5fb4">
  <title><%= typeof titre !== 'undefined' ? titre + ' — ' : '' %>Copro La Pinède de Notre Dame</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
</head>
<body>
<% if (user) { %>
<header class="barre">
  <a class="marque" href="/tickets">🏠 Copro La Pinède de Notre Dame</a>
  <nav class="nav">
    <a href="/tickets">Tickets</a>
    <a href="/tickets/nouveau" class="bouton-nav">+ Nouveau ticket</a>
    <a href="/notifications" class="nav-notif">🔔<% if (nonLues > 0) { %><span class="badge"><%= nonLues %></span><% } %></a>
    <% if (user.conseil_syndical === 1 || user.role === 'admin') { %>
      <a href="/tableau-de-bord">Tableau de bord</a>
    <% } %>
    <% if (user.conseil_syndical === 1 || user.role === 'admin') { %>
      <a href="/admin/comptes">Comptes</a>
    <% } %>
    <a href="/profil">👤 <%= user.prenom || user.nom %><% if (user.conseil_syndical === 1) { %> <span class="tag-cs">CS</span><% } %></a>
  </nav>
</header>
<% } %>
<main class="contenu">
